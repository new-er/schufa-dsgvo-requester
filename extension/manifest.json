{
  "manifest_version": 3,
  "name": "SCHUFA DSGVO Requester",
  "version": "0.1.0",
  "description": "Request your SCHUFA data copy (Art. 15 DSGVO) via a prefilled email, with a recurring reminder.",
  "permissions": ["storage", "alarms", "notifications"],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "SCHUFA DSGVO Requester"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "schufa-dsgvo-requester@new-er",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
