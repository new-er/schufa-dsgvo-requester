[mail]
smtp_host = "smtp.example.com"
smtp_port = 587
username  = "user@example.com"
password  = "app-password"
from_addr = "user@example.com"
to_addr   = "info@schufa.de"

[personal]
vorname      = "Max"
nachname     = "Mustermann"
geburtsdatum = "04.04.2000"
strasse      = "Musterstraße 12"
plz          = "12345"
wohnort      = "Musterstadt"
land         = "Deutschland"

[schedule]
interval_months = 3
